{
  "info": {
    "name": "Užduočių REST API",
    "description": "Paleiskite PHP serverį ir vykdykite užklausas iš eilės. Viena užduotis sukuriama ir galiausiai ištrinama.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "baseUrl", "value": "http://127.0.0.1:8000" }],
  "item": [
    {
      "name": "Sąrašas",
      "request": { "method": "GET", "url": "{{baseUrl}}/tasks" }
    },
    {
      "name": "Sukurti",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"title\":\"Pirkti pieno\",\"done\":false}" },
        "url": "{{baseUrl}}/tasks"
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Sukurta: 201', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('taskId', pm.response.json().id);"
          ]
        }
      }]
    },
    {
      "name": "Viena užduotis",
      "request": { "method": "GET", "url": "{{baseUrl}}/tasks/{{taskId}}" },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Rasta: 200', () => pm.response.to.have.status(200));",
            "pm.test('Yra veiksmų nuorodos', () => pm.expect(pm.response.json()._links).to.have.property('delete'));",
            "pm.collectionVariables.set('etag', pm.response.headers.get('ETag'));"
          ]
        }
      }]
    },
    {
      "name": "Nepasikeitė (ETag)",
      "request": {
        "method": "GET",
        "header": [{ "key": "If-None-Match", "value": "{{etag}}" }],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": ["pm.test('Nepasikeitė: 304', () => pm.response.to.have.status(304));"] }
      }]
    },
    {
      "name": "Pakeisti",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\"title\":\"Pirkti duonos\",\"done\":true}" },
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": ["pm.test('Pakeista: 200', () => pm.response.to.have.status(200));"] }
      }]
    },
    {
      "name": "Senas ETag nebegalioja",
      "request": {
        "method": "GET",
        "header": [{ "key": "If-None-Match", "value": "{{etag}}" }],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": ["pm.test('Pakeisti duomenys: 200', () => pm.response.to.have.status(200));"] }
      }]
    },
    {
      "name": "Ištrinti",
      "request": { "method": "DELETE", "url": "{{baseUrl}}/tasks/{{taskId}}" },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": ["pm.test('Ištrinta: 204', () => pm.response.to.have.status(204));"] }
      }]
    },
    {
      "name": "Ištrinta užduotis nerandama",
      "request": { "method": "GET", "url": "{{baseUrl}}/tasks/{{taskId}}" },
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": ["pm.test('Nerasta: 404', () => pm.response.to.have.status(404));"] }
      }]
    }
  ]
}
